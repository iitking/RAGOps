# ==============================================================================
# RAGOps Environment Configuration
# ==============================================================================

# Application environment (production | development | staging)
APP_ENV=production
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
EVAL_DATA_DIR=data/eval
REPORTS_DIR=reports

# Vector Database (inmemory | qdrant)
VECTOR_STORE_TYPE=inmemory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ragops_documents

# Embeddings Configuration (Real Mode)
# Options: sentence-transformers (local neural), openai (hosted API), hash (offline CI smoke)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# For OpenAI text-embedding-3-small:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# Generator LLM Configuration (Real Mode)
# Options: openai (gpt-4o-mini), gemini (gemini-1.5-flash), anthropic (claude-3-5-haiku), mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=

# Chunking & Retrieval Strategy (Production Calibration)
CHUNK_SIZE=300
CHUNK_OVERLAP=60
TOP_K=5
MIN_SIMILARITY=0.0

# CI Quality Gate Thresholds
GATE_MIN_CONTEXT_RECALL=0.90
GATE_MIN_CONTEXT_PRECISION=0.70
GATE_MIN_FAITHFULNESS=0.85
GATE_MIN_ANSWER_RELEVANCY=0.80
GATE_MAX_HALLUCINATION_RATE=0.02

# Observability & Tracing (Langfuse)
ENABLE_LOCAL_TRACING=true
LOCAL_TRACES_PATH=reports/traces.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
