# ==============================================================================
# RAGOps Environment Configuration
# ==============================================================================

# Application environment (development | staging | production)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Paths
DATA_DIR=data
RAW_DATA_DIR=data/raw
EVAL_DATA_DIR=data/eval
REPORTS_DIR=reports

# Vector Database (inmemory | qdrant)
VECTOR_STORE_TYPE=inmemory
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ragops_documents

# Embeddings
# Options: hash (fast offline), sentence-transformers, openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Generation
# Options: mock (offline deterministic), openai, anthropic
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# Chunking & Retrieval Strategy
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
MIN_SIMILARITY=0.0

# CI Quality Gate Thresholds
GATE_MIN_CONTEXT_RECALL=0.90
GATE_MIN_CONTEXT_PRECISION=0.70
GATE_MIN_FAITHFULNESS=0.85
GATE_MIN_ANSWER_RELEVANCY=0.80
GATE_MAX_HALLUCINATION_RATE=0.02

# Observability & Tracing (Langfuse)
ENABLE_LOCAL_TRACING=true
LOCAL_TRACES_PATH=reports/traces.jsonl
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
